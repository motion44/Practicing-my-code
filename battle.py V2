import random

enemy_health = 10
player_health = 10

print("You will now be battling an enemy! Choose between attacking or healing yourself per turn, and so will the enemy, they will choose to attack you or heal themselves. First person to lose all their health loses the game! Good luck and have fun!")

print("For each turn, type in 1 to attack, 2 to heal")

while enemy_health > 0 and player_health > 0:
    
    choice = input("It is now your turn, type in your choice ")
    
    if choice != "1" and choice != "2":
        print("Invalid input!")
        continue

    choice = int(choice)

    # Players turn
    if choice == 1:
        damage_amount = random.randint(1, 3)
        print(f"You have dealt {damage_amount} damage to the enemy!")
        enemy_health = enemy_health - damage_amount
        
    elif choice == 2:
        if player_health < 10:
            heal_amount = random.randint(1, 2)
            print(f"You have healed {heal_amount} hp for yourself!")
            player_health = player_health + heal_amount
        else:
            print("You are already at full health, you dont need to heal!")
        
        if player_health > 10:
            player_health = 10
            
    if enemy_health <= 0:
        print("The game is over! You have defeated the enemy!")
        break
    
    # Enemys turn
    enemy_choice = random.randint(1, 2)
    
    if enemy_choice == 1:
        enemy_damage_amount = random.randint(1, 3)
        print(f"The enemy has dealt {enemy_damage_amount} damage to you!")
        player_health = player_health - enemy_damage_amount
        
    elif enemy_choice == 2:
        if enemy_health < 10:
            enemy_heal_amount = random.randint(1, 2)
            print(f"The enemy has healed {enemy_heal_amount} hp for themself!")
            enemy_health = enemy_health + enemy_heal_amount
        else:
            print("Enemy tried to heal but is already full!")
            
        if enemy_health > 10:
            enemy_health = 10
        
    print(f"Your health is {player_health}")
    print(f"Enemy's health is {enemy_health}")

    if player_health <= 0:
        print("Game over! You have been defeated!")
        break
